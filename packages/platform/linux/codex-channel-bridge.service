[Unit]
Description=Codex Channel Bridge Supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codex-bridge
Group=codex-bridge
WorkingDirectory=/opt/codex-channel-bridge
Environment=NODE_ENV=production
EnvironmentFile=-/etc/codex-channel-bridge/service.env
ExecStart=/usr/bin/node /opt/codex-channel-bridge/packages/cli/dist/main.js supervisor run --config /etc/codex-channel-bridge/config.yaml --endpoint /run/codex-channel-bridge/control.sock
Restart=on-failure
RestartSec=5
RuntimeDirectory=codex-channel-bridge
RuntimeDirectoryMode=0700
UMask=0077
KillMode=mixed
TimeoutStopSec=320

[Install]
WantedBy=multi-user.target
