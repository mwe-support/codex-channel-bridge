{
  "name": "codex-channel-bridge",
  "version": "0.2.0-rc.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "website"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "npm run build && npm run test:unit && npm run test:release-tool && npm run test:platform-contract",
    "test:unit": "node --test packages/*/dist/*.test.js",
    "test:release-tool": "node --test scripts/*.test.mjs",
    "test:contract": "npm run build && node packages/codex-app-server/dist/protocol-contract.contract.js",
    "test:control-contract": "npm run build && node --test packages/control-plane/dist/control-plane.contract.js",
    "test:supervisor-contract": "npm run build && node packages/supervisor/dist/worker-process.contract.js",
    "test:platform-contract": "node --test packages/platform/platform.test.mjs",
    "test:qq-live": "npm run build && node scripts/qq-live-contract.mjs",
    "test:smoke": "npm run build && node scripts/smoke-turn.mjs",
    "docs:start": "npm --workspace website run start",
    "docs:build": "npm --workspace website run build",
    "docs:test": "npm --workspace website test",
    "docs:serve": "npm --workspace website run serve",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:check": "node scripts/release.mjs check",
    "release:notes": "node scripts/release.mjs notes",
    "check": "npm run release:check && npm run clean && npm run test"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
