{
  "name": "codex-channel-bridge",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "node scripts/clean.mjs",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test packages/*/dist/*.test.js",
    "test:contract": "npm run build && node packages/codex-app-server/dist/protocol-contract.contract.js",
    "test:smoke": "npm run build && node scripts/smoke-turn.mjs",
    "check": "npm run clean && npm run test"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
